# Copy to .env for local development and replace the secret with a random value.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set these with credentials from the Daraja portal; keep populated .env files uncommitted.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Daraja requires this callback to be publicly reachable over HTTPS.
MPESA_CALLBACK_URL=https://your-public-domain.example/payments/mpesa/callback/
SCHOOL_MPESA_PAYBILL=
